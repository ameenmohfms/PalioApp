# Copy to .env for local development. NEVER commit .env.

# --- Runtime ---
APP_ENV=development                 # development | test | production (unset => production)
DATA_REGION=dev-local               # production: KSA/ME region identifier (PDPL §14)

# --- Database ---
POSTGRES_USER=palio
POSTGRES_PASSWORD=palio-dev-only
POSTGRES_DB=palio
DATABASE_URL=postgresql+psycopg://palio:palio-dev-only@db:5432/palio

# --- Anthropic ---
ANTHROPIC_API_KEY=
PALIO_MODEL_FAST=claude-haiku-4-5   # sentinel pre/post, router
PALIO_MODEL_MAIN=claude-sonnet-5    # companion/coach/psychoed/assessment + async jobs

# --- Safety / budgets ---
PALIO_DAILY_TOKEN_BUDGET_PER_USER=200000
ALLOW_UNVERIFIED_CRISIS_CONFIG=0    # dev-only escape hatch; refused when APP_ENV=production

# --- Agent kill-switches (1 = disabled) ---
PALIO_KILL_COMPANION=0
PALIO_KILL_ASSESSMENT=0
PALIO_KILL_PSYCHOEDUCATION=0
PALIO_KILL_COACH=0
PALIO_KILL_PATTERN_EXTRACTOR=0
PALIO_KILL_CASE_REVIEW=0
PALIO_KILL_REPORTS=0
